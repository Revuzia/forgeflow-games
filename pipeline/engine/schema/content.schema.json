{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ffg://content.schema.json",
  "title": "FFG Game Content (base)",
  "description": "The single contract emitted by the generator and read by QA. Genre-specific fields are validated by the matching profile in schema/profiles/<genre>.schema.json. This base layer is genre-agnostic.",
  "type": "object",
  "required": ["title", "slug", "genre", "view"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "genre": {
      "type": "string",
      "description": "Must match a key in registry.json.",
      "enum": ["tactics", "topdown", "platformer", "shmup", "rts", "tower-defense", "arcade", "beatemup", "metroidvania", "turn-rpg", "battleship"]
    },
    "tagline": { "type": "string", "maxLength": 160 },
    "seed": { "type": "integer" },
    "view": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 240, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 180, "maximum": 1080 },
        "background": { "type": "string", "pattern": "^#?[0-9a-fA-F]{3,8}$" },
        "pixelArt": { "type": "boolean" },
        "fog": { "type": "number", "minimum": 0, "maximum": 1, "description": "3D only — exponential fog density." }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "url"],
            "properties": { "key": { "type": "string" }, "url": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "url"],
            "properties": { "key": { "type": "string" }, "url": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": { "music": { "type": "string" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

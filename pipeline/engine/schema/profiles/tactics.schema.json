{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ffg://profiles/tactics.schema.json",
  "title": "FFG Tactics content profile",
  "description": "Grid tactics (XCOM / Fire Emblem / Into the Breach). Validated on top of content.schema.json. The runtime ffg_tactics.js consumes exactly these fields.",
  "type": "object",
  "required": ["genre", "missions"],
  "properties": {
    "genre": { "const": "tactics" },
    "missions": {
      "type": "array",
      "minItems": 1,
      "description": "First mission is the vertical slice (must pass the signature gate before expansion).",
      "items": {
        "type": "object",
        "required": ["grid", "player_units", "enemy_units"],
        "properties": {
          "name": { "type": "string" },
          "objective": { "type": "string" },
          "grid": {
            "type": "array",
            "minItems": 3,
            "description": "2D row-major array. 0=floor 1=wall 2=half-cover 3=full-cover 4=hazard.",
            "items": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "integer", "minimum": 0, "maximum": 4 }
            }
          },
          "player_units": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/unit" }
          },
          "enemy_units": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/unit" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["id", "x", "y", "hp"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "hp": { "type": "integer", "minimum": 1 },
        "atk": { "type": "integer", "minimum": 0 },
        "def": { "type": "integer", "minimum": 0 },
        "movement": { "type": "integer", "minimum": 1, "maximum": 12 },
        "range": { "type": "integer", "minimum": 1, "maximum": 30 },
        "aim": { "type": "number", "minimum": 0, "maximum": 1 },
        "ai": { "type": "string", "enum": ["aggressive", "defensive", "sniper"] },
        "tint": { "type": ["string", "integer"] },
        "sprite": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}

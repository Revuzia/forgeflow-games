{
  "name": "vale-net",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VALE game server on Cloudflare: one Worker + one SQLite-backed Durable Object running games/vale/server/hub_core.ts",
  "scripts": {
    "dev": "wrangler dev --local --port 8791",
    "typecheck": "wrangler types --env-interface CfEnv && node ../../games/vale/node_modules/typescript/bin/tsc -p tsconfig.json",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "test": "node test/run_probes.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.92.0"
  }
}

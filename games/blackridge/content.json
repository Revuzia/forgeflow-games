    "path": ["dock_spawn", "quay_mid", "alley_dogleg_s", "alley_dogleg_n", "plaza_west", "plaza_center", "arcade_ground", "arcade_upper", "gallery_mid", "blvd_mid", "blvd_barricade", "platform_deck", "customs_sandbags", "gate9", "exfil"],


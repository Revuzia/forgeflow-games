  "_contract": {
    "nodes": "every node ref resolves against buildColliders().nodes — the 15 frozen R24 keys (core/level/colliders.js)",
    "weapons": "every weapon ref resolves against WEAPONS in core/weapons/weapon_data.js (R4 ids: warden/vesper/corvus/pike)",
    "gate": "A1's makeMission()/selftest contract gate throws on ANY dangling spawn/wave/objective/archetype/node/weapon/scenario ref (the Colosseum empty-bout lesson)",
    "triggers": "trigger vocabulary: {kind:'missionStart'} | {kind:'beat',beat} | {kind:'reach',node|area,radius?} (area=[[minX,minZ],[maxX,maxZ]]) | {kind:'contact',beat} (first shot by anyone OR first bot confirm while that beat is active) | {kind:'waveAlive',wave,lte} (wave fully spawned AND alive<=lte) | {kind:'objective',id} (fires when that objective completes) | {kind:'anyOf',of:[...]}",
    "beatOrdering": "beats advance strictly in order; only the NEXT beat's trigger is armed (entering a later beat's area early does nothing). Known edge: a rusher entering the arcade during beat 3 can have 9 bots alive briefly (5 plaza + 4 arcade) — above LD's 8 content guidance, inside the 12 engine budget (R23); A1's spawner may queue above 12, never above."
  },
  "version": 1,

  "mission": {
    "id": "meridian_ward",
    "title": "Operation BLACKRIDGE — Meridian Ward",
    "fiction": {
      "city": "Zarov",
      "district": "Meridian Ward",
      "operation": "BLACKRIDGE",
      "playerCallsign": "RAVEN 2-1",
      "enemy": "Vektor Ancile",
      "macguffin": "CINDERLOCK",
      "premise": "A storm blackout has cut the ward's grid. Vektor Ancile, a delisted PMC turned arms broker, is moving CINDERLOCK — a stolen missile-guidance module — through Meridian Ward to a freighter that sails at dawn. Infiltrate from the freight canal, seize the case at the handoff point, and hold Customs Gate 9 until extraction.",
      "_ip": "all names invented for this project (level_design §1/§7 — no real brands, cities, units, or CoD references)"
    },
    "loadout": { "slots": ["warden", "pike"], "grenades": 2 },
    "death": { "respawnAt": "beat_checkpoint", "fadeS": 1.2, "_comment": "R22 — death restarts the current beat: full HP, loadout as at beat entry, completed objectives persist. Forfeit routes through the real loss path." },

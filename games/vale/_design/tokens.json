    "fighterLight": { "keyViewAzimuthDeg": 225, "keyViewElevationDeg": 45, "keyIntensityOfSun": 0.9, "rimFrom": "sun side", "shadowFloor": 0.75, "shader": "shadow = mix(1.0, s, 0.25)" },

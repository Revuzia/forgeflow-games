  "meta": {
    "name": "VALE style tokens",
    "version": "1.0.0",
    "date": "2026-10-07",
    "law": "_design/STYLE_BIBLE.md (this file is its machine-readable half; when they disagree, fix both in one change)",
    "verify": "python3 _design/tools/verify_tokens.py  (recomputes every contrast and CIEDE2000 figure quoted in the bible)",
    "colorSpace": "sRGB hex. Overlay colours (bars, rings, telegraphs, HUD) are drawn after tone mapping + LUT, so the hex IS the screen pixel.",

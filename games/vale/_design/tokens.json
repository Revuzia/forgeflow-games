  "grade": {
    "toneMapping": "NEUTRAL",
    "exposure": 1.0,
    "passOrder": ["RenderPass(HalfFloat, renderer.toneMapping = NoToneMapping)", "N8AOPostPass", "EffectPass(Bloom, ToneMapping NEUTRAL, LUT3D vale_grade_01, Vignette)", "OverlayPass(telegraphs, ground rings, range indicators, pings; ungraded, depth-tested)", "EffectPass(SMAA; FXAA on Low)"],
    "contractNote": "CONTRACT section 9 lists LUT3D before tone mapping; LUT3DEffect expects display-referred sRGB, so tone mapping must run first. Contract change requested.",
    "lut": {
      "id": "vale_grade_01",
      "file": "vale_grade_01.cube",
      "size": 33,
      "input": "Neutral-tonemapped display sRGB",
      "tetrahedral": ["high", "ultra"],
      "locked": "one LUT for every map, the menu world and the showcase; hash pinned; change needs art-director sign-off + readability re-test",
      "ops": [
        { "op": "lift", "rgb": [-0.004, 0.0, 0.012] },
        { "op": "gamma", "rgb": [1.0, 1.0, 0.985], "note": "out = in^(1/gamma)" },
        { "op": "gain", "rgb": [1.025, 1.0, 0.975] },
        { "op": "contrast", "amount": 1.06, "pivot": 0.33, "softToeShoulder": true, "why": "r12 B5: the pivot sits at the rebased ground (display ~0.33), so the S-curve lifts fighters and effects above it" },
        { "op": "satByLuma", "bands": [[0.0, 0.15, 0.85], [0.15, 0.6, 1.05], [0.6, 0.85, 1.0], [0.85, 1.0, 0.92]], "featherLuma": 0.05 },
        { "op": "hueSat", "space": "HSV", "featherDeg": 8, "bands": [
          { "hue": [75, 150], "sat": 0.88, "why": "foliage recedes, never competes with heal" },
          { "hue": [170, 200], "sat": 0.9 },
          { "hue": [200, 225], "sat": 0.85, "onlyIfValueBelow": 0.85, "why": "world chroma near ally azure is suppressed; emissive accents (V >= 0.85) untouched" },
          { "hue": [25, 50], "sat": 0.85, "onlyIfValueBelow": 0.85, "why": "world chroma near harm marigold is suppressed" }
        ] },
        { "op": "hueShift", "space": "HSV", "hue": [75, 150], "deg": -5, "featherDeg": 8 },
        { "op": "gamutSoftClip", "space": "OKLCH", "kneeChroma": 0.2, "maxChroma": 0.24 }

}
/** table T at p (cycle steps, any real), column c (0 g, 1 G) */
function tab(T: Float64Array, p: number, c: number): number {
  let x = p % NT;
  if (x < 0) x += NT;
  const i = x | 0, f = x - i, o = i * 2 + c;
  return T[o] + (T[o + 2] - T[o]) * f;
}

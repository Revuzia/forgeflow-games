{
  "$comment": "Biomes (CONTRACT §7.1). 'biomes' defines the 18 biomes (index = biome id in the 'biome' field) with map colours and what PAINTING the biome sets on a cell. 'rules' classifies cells: tried in ORDER, the first rule whose conditions hold names the biome (a rule without conditions always matches). Variables: air (atm), toxic (0..1), ocean (0/1 connected sea), coast (0/1 touches the sea), water (m standing), seaIce (m), temp (slow mean °C), moisture (soil 0..1), alt (m above sea level), slope (rise/run), sand, snow, ice, lava, ash, soil (m), salinity (0..1), tree/shrub/grass (cover 0..1). Conditions: [variable, op, value], op one of < <= > >= == !=; 'all' = every condition, 'any' = at least one. Unless pinned, painted cells drift back toward what their climate supports.",
  "biomes": [
    { "id": "ocean", "name": "Ocean", "color": "#1d4f7a", "paint": { "water": 6 } },
    { "id": "reef", "name": "Reef", "color": "#3fb8b0", "paint": { "tree": 0.6, "species": { "tree": "kelp" } } },
    { "id": "coast", "name": "Coast", "color": "#d9c896",
      "paint": { "grass": 0.25, "shrub": 0.1, "tree": 0.08, "sand": 1.2, "soil": 0.1, "moisture": 0.45, "species": { "tree": "palm", "grass": "meadow-grass" } } },
    { "id": "ice", "name": "Ice sheet", "color": "#e8f0f6",
      "paint": { "grass": 0, "shrub": 0, "tree": 0, "snow": 1.0, "ice": 2.0, "moisture": 0.6 } },
    { "id": "tundra", "name": "Tundra", "color": "#9fa88a",
      "paint": { "grass": 0.6, "shrub": 0.35, "tree": 0.02, "soil": 0.3, "moisture": 0.55, "snow": 0.2, "species": { "grass": "moss-lichen", "shrub": "tundra-shrub" } } },
    { "id": "taiga", "name": "Taiga", "color": "#2f5a44",
      "paint": { "grass": 0.4, "shrub": 0.3, "tree": 0.8, "soil": 0.5, "moisture": 0.6, "species": { "tree": "spruce", "shrub": "tundra-shrub", "grass": "moss-lichen" } } },
    { "id": "grassland", "name": "Grassland", "color": "#7fa04a",
      "paint": { "grass": 0.9, "shrub": 0.1, "tree": 0.04, "soil": 0.6, "moisture": 0.42, "species": { "grass": "wild-grain", "shrub": "berry-bush" } } },
    { "id": "forest", "name": "Forest", "color": "#2f6b34",
      "paint": { "grass": 0.4, "shrub": 0.45, "tree": 0.85, "soil": 0.8, "moisture": 0.6, "species": { "tree": "oak", "shrub": "berry-bush", "grass": "meadow-grass" } } },
    { "id": "rainforest", "name": "Rainforest", "color": "#1f6b2e",
      "paint": { "grass": 0.3, "shrub": 0.7, "tree": 0.95, "soil": 0.9, "moisture": 0.85, "species": { "tree": "kapok", "shrub": "fern", "grass": "wild-rice" } } },
    { "id": "wetland", "name": "Wetland", "color": "#4f7a5a",
      "paint": { "grass": 0.85, "shrub": 0.3, "tree": 0.25, "soil": 0.8, "moisture": 0.95, "water": 0.2, "species": { "grass": "reeds", "tree": "willow" } } },
    { "id": "desert", "name": "Desert", "color": "#d6b47a",
      "paint": { "grass": 0.04, "shrub": 0.08, "tree": 0, "sand": 0.8, "soil": 0.05, "moisture": 0.05, "species": { "shrub": "cactus" } } },
    { "id": "dune", "name": "Dune sea", "color": "#e3c27a",
      "paint": { "grass": 0, "shrub": 0.02, "tree": 0, "sand": 4.0, "soil": 0, "moisture": 0.03 } },
    { "id": "scrub", "name": "Scrubland", "color": "#a39a68",
      "paint": { "grass": 0.35, "shrub": 0.6, "tree": 0.05, "soil": 0.25, "moisture": 0.18, "species": { "shrub": "sagebrush", "grass": "steppe-grass" } } },
    { "id": "mountain", "name": "Mountain", "color": "#7a7068",
      "paint": { "grass": 0.15, "shrub": 0.1, "tree": 0.05, "soil": 0.1, "moisture": 0.35, "species": { "grass": "moss-lichen" } } },
    { "id": "volcanic", "name": "Volcanic field", "color": "#3a2a26",
      "paint": { "grass": 0, "shrub": 0, "tree": 0, "soil": 0.05, "ash": 0.5, "moisture": 0.1 } },
    { "id": "barren", "name": "Barren rock", "color": "#8a857c",
      "paint": { "grass": 0, "shrub": 0, "tree": 0, "soil": 0.0, "moisture": 0.0 } },
    { "id": "savanna", "name": "Savanna", "color": "#b7a85a",
      "paint": { "grass": 0.85, "shrub": 0.2, "tree": 0.15, "soil": 0.5, "moisture": 0.3, "species": { "tree": "acacia", "grass": "savanna-grass" } } },
    { "id": "steppe", "name": "Steppe", "color": "#b5ad78",
      "paint": { "grass": 0.8, "shrub": 0.15, "tree": 0.02, "soil": 0.45, "moisture": 0.25, "species": { "grass": "steppe-grass", "shrub": "sagebrush" } } }
  ],
  "rules": [
    { "biome": "volcanic", "any": [["lava", ">", 0.05], ["ash", ">", 0.35]] },
    { "biome": "barren", "any": [["air", "<", 0.02], ["toxic", ">", 0.6], ["temp", ">", 65]] },
    { "biome": "ice", "all": [["temp", "<", -45]] },
    { "biome": "ice", "any": [["ice", ">", 0.6], ["seaIce", ">", 0.25], ["snow", ">", 2.0]] },
    { "biome": "reef", "all": [["ocean", "==", 1], ["water", "<", 14], ["temp", ">", 19], ["salinity", ">", 0.4]] },
    { "biome": "ocean", "any": [["ocean", "==", 1], ["water", ">", 4]] },
    { "biome": "wetland", "all": [["temp", ">", -2]], "any": [["water", ">", 0.08], ["moisture", ">", 0.88]] },
    { "biome": "barren", "all": [["soil", "<", 0.03], ["sand", "<", 0.15], ["grass", "<", 0.05], ["shrub", "<", 0.05], ["tree", "<", 0.05], ["snow", "<", 0.2]] },
    { "biome": "coast", "all": [["coast", "==", 1], ["alt", "<", 6], ["slope", "<", 0.25]] },
    { "biome": "mountain", "any": [["alt", ">", 280], ["slope", ">", 0.7]] },
    { "biome": "dune", "all": [["sand", ">", 1.0], ["moisture", "<", 0.22]] },
    { "biome": "desert", "all": [["moisture", "<", 0.1], ["temp", ">", -2]] },
    { "biome": "tundra", "all": [["temp", "<", -3]] },
    { "biome": "taiga", "all": [["temp", "<", 6], ["moisture", ">", 0.3]] },
    { "biome": "rainforest", "all": [["temp", ">", 19], ["moisture", ">", 0.68]] },
    { "biome": "savanna", "all": [["temp", ">", 18], ["moisture", "<", 0.45], ["moisture", ">=", 0.1]] },
    { "biome": "scrub", "all": [["moisture", "<", 0.25], ["temp", ">", 6]] },
    { "biome": "steppe", "all": [["moisture", "<", 0.32]] },
    { "biome": "forest", "any": [["tree", ">", 0.45], ["moisture", ">", 0.52]] },
    { "biome": "grassland" }
  ]
}
